<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#292827">

    <LinearLayout
        android:id="@+id/chrome_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="6dp"
        android:background="#1F1E1D">

        <Button
            android:id="@+id/btn_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="←"
            android:textColor="#F2EEE9"
            android:backgroundTint="#71394B" />

        <Button
            android:id="@+id/btn_forward"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:text="→"
            android:textColor="#F2EEE9"
            android:backgroundTint="#71394B" />

        <Button
            android:id="@+id/btn_reload"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:text="⟳"
            android:textColor="#F2EEE9"
            android:backgroundTint="#71394B" />

        <EditText
            android:id="@+id/address"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:hint="@string/address_hint"
            android:inputType="textUri"
            android:imeOptions="actionGo"
            android:singleLine="true"
            android:textColor="#F2EEE9"
            android:textColorHint="#AAA5A1"
            android:background="#35322F"
            android:paddingHorizontal="12dp" />

        <Button
            android:id="@+id/btn_go"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:text="@string/go"
            android:textColor="#F2EEE9"
            android:backgroundTint="#71394B" />

        <Button
            android:id="@+id/btn_home"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:text="⌂"
            android:textColor="#F2EEE9"
            android:backgroundTint="#71394B" />

        <TextView
            android:id="@+id/shield_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/blocked_zero"
            android:textColor="#B99A7D"
            android:textSize="13sp" />
    </LinearLayout>

    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
